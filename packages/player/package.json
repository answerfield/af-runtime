{
  "name": "@answerfield/player",
  "version": "0.1.0",
  "description": "Schnittstelle für Hosts: Aufgaben und Testhefte einbetten (framework-neutral); Runtime und Renderer bleiben intern",
  "type": "module",
  "files": [
    "out",
    "!out/**/*.map",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./out/index.d.ts",
      "af-source": "./src/index.ts",
      "default": "./out/index.js"
    }
  },
  "scripts": {
    "build": "tsc -b",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@answerfield/bundle": "https://github.com/answerfield/af-format/releases/download/v0.1.0/answerfield-bundle-0.1.0.tgz",
    "@answerfield/runtime-core": "0.1.0",
    "@answerfield/runtime-wc": "0.1.0"
  },
  "optionalDependencies": {
    "@answerfield/practice": "0.1.0"
  },
  "devDependencies": {
    "@answerfield/compiler": "https://github.com/answerfield/af-language/releases/download/v0.1.0/answerfield-compiler-0.1.0.tgz",
    "happy-dom": "^21.0.1",
    "vitest": "^5.0.5"
  },
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/answerfield/af-runtime",
    "directory": "packages/player"
  }
}
